<UserControl x:Class="Vido.Setup.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Success icon -->
        <Border Grid.Row="1"
                Width="56" Height="56"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                CornerRadius="28"
                Background="{StaticResource SidebarBackgroundBrush}">
            <TextBlock Text="✓"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource SuccessForegroundBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Success text -->
        <TextBlock Grid.Row="2"
                   Text="Vido has been installed successfully!"
                   FontSize="16"
                   Foreground="{StaticResource PrimaryForegroundBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <!-- Run after install checkbox -->
        <CheckBox Grid.Row="3"
                  IsChecked="{Binding RunAfterInstall}"
                  Content="Run Vido"
                  Foreground="{StaticResource PrimaryForegroundBrush}"
                  FontSize="13"
                  HorizontalAlignment="Center"
                  Cursor="Hand" />

        <!-- Finish button -->
        <Button Grid.Row="5"
                Command="{Binding FinishCommand}"
                Width="200" Height="40"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{StaticResource ButtonBackgroundBrush}"
                                        CornerRadius="4">
                                    <TextBlock Text="Finish"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder"
                                                Property="Background"
                                                Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
