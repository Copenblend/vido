<Window x:Class="Vido.Views.Updates.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check for Updates"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{StaticResource EditorBackgroundBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}">
                <TextBlock Text="Check for Updates"
                           Foreground="{StaticResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12" />
                <Button x:Name="CloseButton"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        HorizontalAlignment="Right"
                        Width="46" Height="32"
                        BorderThickness="0"
                        Foreground="{StaticResource PrimaryForegroundBrush}"
                        Background="Transparent"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                                        Property="Background"
                                                        Value="{StaticResource WindowCloseHoverBackgroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="1" Margin="30,16">

                <!-- Info state: update available -->
                <StackPanel x:Name="InfoPanel" VerticalAlignment="Top">
                    <!-- Logo + title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Image Source="/Assets/Vido.png" Width="32" Height="32"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="InfoHeading"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="InfoSubtext"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <!-- Release notes -->
                    <ScrollViewer x:Name="ReleaseNotesScroller"
                                  MaxHeight="200"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,16">
                        <TextBlock x:Name="ReleaseNotesText"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Update Now button (accent) -->
                        <Button x:Name="UpdateNowButton"
                                Width="130" Height="34"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                Click="UpdateNowButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource ButtonDefaultBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Update Now"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource ButtonBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Later button -->
                        <Button x:Name="InfoLaterButton"
                                Width="130" Height="34"
                                Cursor="Hand"
                                Click="LaterButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource InputBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Later"
                                                               FontSize="13"
                                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Downloading state -->
                <StackPanel x:Name="DownloadingPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Downloading update..."
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <ProgressBar x:Name="DownloadProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6"
                                 Margin="0,0,0,12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3" />
                                                <Border x:Name="PART_Indicator"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Left" />
                                                <Border x:Name="PART_Track" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock x:Name="DownloadPercentText"
                               Text="0%"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!-- Cancel button -->
                    <Button x:Name="CancelDownloadButton"
                            Width="130" Height="34"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="CancelDownloadButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{StaticResource InputBackgroundBrush}"
                                                    CornerRadius="4">
                                                <TextBlock Text="Cancel"
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder"
                                                            Property="Background"
                                                            Value="{StaticResource HoverBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Downloaded state -->
                <StackPanel x:Name="DownloadedPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Success icon -->
                    <Border Width="48" Height="48"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            CornerRadius="24"
                            Background="{StaticResource SidebarBackgroundBrush}">
                        <TextBlock Text="✓"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Update downloaded. Restart to complete."
                               FontSize="15"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Restart Now button (accent) -->
                        <Button x:Name="RestartNowButton"
                                Width="130" Height="34"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                Click="RestartNowButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource ButtonDefaultBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Restart Now"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource ButtonBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Later button -->
                        <Button x:Name="DownloadedLaterButton"
                                Width="130" Height="34"
                                Cursor="Hand"
                                Click="LaterButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource InputBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Later"
                                                               FontSize="13"
                                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Error state -->
                <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Error icon -->
                    <Border Width="48" Height="48"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            CornerRadius="24"
                            Background="{StaticResource SidebarBackgroundBrush}">
                        <TextBlock Text="✕"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="ErrorMessageText"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Open Release Page button -->
                        <Button x:Name="OpenReleasePageButton"
                                Width="160" Height="34"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                Click="OpenReleasePageButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource ButtonDefaultBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Open Release Page"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource ButtonBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Close button -->
                        <Button x:Name="ErrorCloseButton"
                                Width="100" Height="34"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource InputBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Close"
                                                               FontSize="13"
                                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Up to date state -->
                <StackPanel x:Name="UpToDatePanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Success icon -->
                    <Border Width="48" Height="48"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            CornerRadius="24"
                            Background="{StaticResource SidebarBackgroundBrush}">
                        <TextBlock Text="✓"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="You're running the latest version of Vido."
                               FontSize="15"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />

                    <TextBlock x:Name="UpToDateVersionText"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <!-- OK button -->
                    <Button x:Name="UpToDateOkButton"
                            Width="130" Height="34"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{StaticResource ButtonDefaultBackgroundBrush}"
                                                    CornerRadius="4">
                                                <TextBlock Text="OK"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder"
                                                            Property="Background"
                                                            Value="{StaticResource ButtonBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
