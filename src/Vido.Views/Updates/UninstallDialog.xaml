<Window x:Class="Vido.Views.Updates.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Vido"
        Width="420" Height="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{StaticResource EditorBackgroundBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}">
                <TextBlock Text="Uninstall Vido"
                           Foreground="{StaticResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12" />
                <Button x:Name="CloseButton"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        HorizontalAlignment="Right"
                        Width="46" Height="32"
                        BorderThickness="0"
                        Foreground="{StaticResource PrimaryForegroundBrush}"
                        Background="Transparent"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                                        Property="Background"
                                                        Value="{StaticResource WindowCloseHoverBackgroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="1" Margin="30,16">
                <!-- Confirmation state -->
                <StackPanel x:Name="ConfirmPanel" VerticalAlignment="Center">
                    <!-- Logo + title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image Source="/Assets/Vido.png" Width="32" Height="32"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Uninstall Vido"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Are you sure you want to uninstall Vido?"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <CheckBox x:Name="DeleteAppDataCheckBox"
                              Content="Also delete settings and app data"
                              Foreground="{StaticResource PrimaryForegroundBrush}"
                              FontSize="13"
                              HorizontalAlignment="Center"
                              Cursor="Hand"
                              Margin="0,0,0,24" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Uninstall button (danger) -->
                        <Button x:Name="UninstallButton"
                                Width="120" Height="34"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                Click="UninstallButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource DangerBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Uninstall"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource DangerHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Cancel button -->
                        <Button x:Name="CancelButton"
                                Width="120" Height="34"
                                Cursor="Hand"
                                Click="CancelButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{StaticResource InputBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="Cancel"
                                                               FontSize="13"
                                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Background"
                                                                Value="{StaticResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Progress state -->
                <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Uninstalling..."
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <ProgressBar x:Name="ProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6"
                                 Margin="0,0,0,12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3" />
                                                <Border x:Name="PART_Indicator"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Left" />
                                                <Border x:Name="PART_Track" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock x:Name="StatusText"
                               Text="Removing registry entries..."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Completion state -->
                <StackPanel x:Name="CompletePanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Success icon -->
                    <Border Width="48" Height="48"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            CornerRadius="24"
                            Background="{StaticResource SidebarBackgroundBrush}">
                        <TextBlock Text="✓"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Vido has been uninstalled."
                               FontSize="15"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <Button x:Name="CloseCompleteButton"
                            Width="120" Height="34"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{StaticResource ButtonBackgroundBrush}"
                                                    CornerRadius="4">
                                                <TextBlock Text="Close"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder"
                                                            Property="Background"
                                                            Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
