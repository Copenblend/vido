<UserControl x:Class="Vido.Views.Pulse.PulseSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vido.ViewModels.Pulse;assembly=Vido.ViewModels"
             xmlns:converters="clr-namespace:Vido.Views.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PulseSidebarViewModel}"
             Background="{StaticResource PanelBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:StateColorToBrushConverter x:Key="StateColorBrush" />
            <converters:FractionToPercentConverter x:Key="FracToPercent" />

            <Style x:Key="GenerateFunscriptButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2D2D2D" />
                <Setter Property="Foreground" Value="#CCCCCC" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PulseScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource PanelBackgroundBrush}">
        <StackPanel Margin="12,8,12,12">

            <!-- ════ Title ════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="&#x2665;"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="PULSE"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- ════ Toggle Row ════ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              Style="{StaticResource PulseToggleStyle}"
                              IsChecked="{Binding UsePulse, Mode=TwoWay}"
                              ToolTip="Enable or disable Pulse beat detection"
                              VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="Use Pulse"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />

                <!-- State indicator dot -->
                <Ellipse Grid.Column="3"
                         Width="8" Height="8"
                         Fill="{Binding StateColor, Converter={StaticResource StateColorBrush}}"
                         VerticalAlignment="Center"
                         Margin="4,0,0,0" />
            </Grid>

            <!-- ════ Analysis Progress ════ -->
            <StackPanel Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,8">
                <ProgressBar Style="{StaticResource PulseProgressBarStyle}"
                             Value="{Binding AnalysisProgress, Converter={StaticResource FracToPercent}, Mode=OneWay}"
                             Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" FontFamily="Segoe UI" />
            </StackPanel>

            <!-- ════ BPM Readout ════ -->
            <StackPanel Visibility="{Binding ShowBpm, Converter={StaticResource BoolToVis}}"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BpmTextBrush}"
                           FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI" />
            </StackPanel>

            <!-- ════ STROKE CONTROLS ════ -->
            <StackPanel Visibility="{Binding ShowBpm, Converter={StaticResource BoolToVis}}"
                        Margin="0,4,0,8">

                <!-- Section Header -->
                <TextBlock Text="STROKE CONTROLS"
                           Style="{StaticResource SectionLabelStyle}" />

                <!-- Beat Rate -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Beat Rate"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource PulseComboBoxStyle}"
                              ItemContainerStyle="{StaticResource PulseComboBoxItemStyle}"
                              ItemsSource="{Binding BeatRateOptions}"
                              SelectedIndex="{Binding SelectedBeatRateIndex, Mode=TwoWay}"
                              ToolTip="Beat rate for live Pulse strokes" />
                </Grid>

                <!-- Amplitude Slider -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Amplitude"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Style="{StaticResource PulseSliderStyle}"
                            Minimum="-1" Maximum="1"
                            Value="{Binding AmplitudeOffset, Mode=TwoWay}"
                            TickPlacement="BottomRight" Ticks="0"
                            SmallChange="0.05" LargeChange="0.1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding AmplitudeOffsetLabel}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Speed Slider -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Speed"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <Slider Style="{StaticResource PulseSliderStyle}"
                                Minimum="-1" Maximum="1"
                                Value="{Binding EasingBlend, Mode=TwoWay}"
                                TickPlacement="BottomRight" Ticks="0"
                                SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center"
                                Margin="0,0,0,10" />
                        <!-- Endpoint labels -->
                        <TextBlock Text="Gentle"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9" FontFamily="Segoe UI"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,0" />
                        <TextBlock Text="Aggressive"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9" FontFamily="Segoe UI"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,0" />
                    </Grid>
                </Grid>

                <!-- Pattern ComboBox -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Pattern"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource PulseComboBoxStyle}"
                              ItemContainerStyle="{StaticResource PulseComboBoxItemStyle}"
                              ItemsSource="{Binding StrokePatternOptions}"
                              SelectedIndex="{Binding SelectedStrokePatternIndex, Mode=TwoWay}"
                              ToolTip="Stroke waveform pattern" />
                </Grid>

                <!-- Randomness Slider -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Randomness"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Style="{StaticResource PulseSliderStyle}"
                            Minimum="0" Maximum="1"
                            Value="{Binding Randomness, Mode=TwoWay}"
                            SmallChange="0.01" LargeChange="0.1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding RandomnessLabel}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- ════ Separator ════ -->
            <Border Height="1"
                    Background="{StaticResource BorderBrush}"
                    Visibility="{Binding ShowBpm, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,8" />

            <!-- ════ Generate Funscript ════ -->
            <Button Visibility="{Binding ShowBpm, Converter={StaticResource BoolToVis}}"
                    Content="Generate Funscript"
                    Style="{StaticResource GenerateFunscriptButtonStyle}"
                    Command="{Binding GenerateFunscriptCommand}"
                    IsEnabled="{Binding CanGenerateFunscript}"
                    ToolTip="Generate a .funscript file from the detected beats"
                    Margin="0,0,0,8" />

            <!-- ════ Separator ════ -->
            <Border Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,4,0,12" />

            <!-- ════ Description ════ -->
            <Border Background="{StaticResource DescriptionBackgroundBrush}"
                    CornerRadius="4"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="About Pulse"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
