<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Tab close button (x) ===== -->
    <Style x:Key="TabCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="3">
                        <Path Data="M 3,3 L 9,9 M 9,3 L 3,9"
                              Stroke="{DynamicResource SecondaryForegroundBrush}"
                              StrokeThickness="1.2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="12" Height="12"
                              Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource HoverBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Show close button when parent border is hovered -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                         Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <!-- Always show close button on active tab -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Scroll arrow buttons for tab overflow ===== -->
    <Style x:Key="TabScrollButtonStyle" TargetType="RepeatButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource TabInactiveBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"
                            Padding="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource HoverBackgroundBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tab strip ScrollViewer (hide scrollbar chrome, keep scrolling) ===== -->
    <Style x:Key="TabScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter Grid.Column="0"
                                                CanContentScroll="True" />

                        <!-- Scroll arrows when tabs overflow -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}">
                            <RepeatButton Content="◀"
                                          Style="{StaticResource TabScrollButtonStyle}"
                                          Command="ScrollBar.LineLeftCommand"
                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                            <RepeatButton Content="▶"
                                          Style="{StaticResource TabScrollButtonStyle}"
                                          Command="ScrollBar.LineRightCommand"
                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Panel tab strip style (for bottom and right panels) ===== -->
    <Style x:Key="PanelTabStripStyle" TargetType="Border">
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}" />
    </Style>

    <!-- ===== Panel tab item style ===== -->
    <Style x:Key="PanelTabItemStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Bottom panel tab item (button-like, highlights on active) ===== -->
    <Style x:Key="BottomPanelTabButtonStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="28" />
    </Style>

    <!-- ===== Bottom panel collapse/expand chevron button ===== -->
    <Style x:Key="PanelCollapseButtonStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="22" Height="22"
                            CornerRadius="3" x:Name="Bd">
                        <Path x:Name="Arrow"
                              Data="M 4,2 L 10,6 4,10"
                              Stroke="{DynamicResource SecondaryForegroundBrush}"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="90" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- When checked (collapsed), chevron points right -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource HoverBackgroundBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource PrimaryForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Right panel collapse/expand chevron button ===== -->
    <Style x:Key="RightPanelCollapseButtonStyle" TargetType="ToggleButton"
           BasedOn="{StaticResource PanelCollapseButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ===== Horizontal splitter (for bottom panel resize) ===== -->
    <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PrimaryBorderBrush}" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent" Margin="0,-5">
                        <!-- Taller transparent hit area for easier grabbing -->
                        <Border Background="Transparent"
                                Height="11"
                                VerticalAlignment="Center" />
                        <!-- Visible 1px divider line -->
                        <Border Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryBorderBrush}"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
