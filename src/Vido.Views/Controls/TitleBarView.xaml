<UserControl x:Class="Vido.Views.Controls.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30"
             Background="{DynamicResource TitleBarBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TitleBarStyles.xaml" />
                <ResourceDictionary Source="../Themes/MenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- App icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Menu bar -->
            <ColumnDefinition Width="Auto" />
            <!-- Draggable title area -->
            <ColumnDefinition Width="*" />
            <!-- Window controls -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- App Icon -->
        <Border Grid.Column="0"
                Width="46"
                Padding="15,0,11,0">
            <Image Source="pack://application:,,,/Vido.Views;component/Assets/Vido.png"
                   Width="16" Height="16"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
        </Border>

        <!-- Menu Bar -->
        <Menu Grid.Column="1"
              Style="{StaticResource TitleBarMenuStyle}"
              WindowChrome.IsHitTestVisibleInChrome="True">

            <!-- File -->
            <MenuItem Header="_File" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="Open _Folder..." InputGestureText="Ctrl+Shift+O"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnOpenFolderClick" />
                <MenuItem x:Name="CloseFolderMenuItem" Header="_Close Folder" InputGestureText="Ctrl+K"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsEnabled="False"
                          Click="OnCloseFolderClick" />
                <MenuItem x:Name="RescanFolderMenuItem" Header="_Rescan Folder" InputGestureText="Ctrl+Shift+R"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsEnabled="False"
                          Click="OnRescanFolderClick" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="_Add File..."
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnAddFileClick" />
                <MenuItem Header="Add F_older..."
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnAddFolderClick" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem x:Name="RecentFilesMenu" Header="_Recent Files"
                          Style="{StaticResource SubmenuParentItemStyle}"
                          SubmenuOpened="OnRecentFilesSubmenuOpened">
                    <MenuItem Header="No recent files" Style="{StaticResource DropdownMenuItemStyle}"
                              IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnExitClick" />
            </MenuItem>

            <!-- Edit -->
            <MenuItem Header="_Edit" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="No actions available"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsEnabled="False" />
            </MenuItem>

            <!-- View -->
            <MenuItem Header="_View" Style="{StaticResource TitleBarMenuItemStyle}"
                      SubmenuOpened="OnViewSubmenuOpened">
                <MenuItem x:Name="ShowHideSidebarMenuItem"
                          Header="_Show Sidebar" InputGestureText="Ctrl+B"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnToggleSidebarClick" />
                <MenuItem x:Name="ShowHideStatusBarMenuItem"
                          Header="Show S_tatus Bar" InputGestureText="Ctrl+Shift+S"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnToggleStatusBarClick" />
                <MenuItem Header="_Fullscreen" InputGestureText="F11"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnFullscreenClick" />
                <MenuItem x:Name="RightPanelMenu"
                          Header="_Right Panel"
                          Style="{StaticResource SubmenuParentItemStyle}"
                          SubmenuOpened="OnRightPanelSubmenuOpened">
                    <MenuItem x:Name="VideoInfoMenuItem"
                              Header="_Video Info"
                              Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnShowVideoInfoClick" />
                    <MenuItem x:Name="ShowHideRightPanelMenuItem"
                              Header="_Show Right Panel" InputGestureText="Ctrl+H"
                              Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnToggleRightPanelClick" />
                </MenuItem>
                <MenuItem x:Name="BottomPanelMenu"
                          Header="_Bottom Panel"
                          Style="{StaticResource SubmenuParentItemStyle}"
                          SubmenuOpened="OnBottomPanelSubmenuOpened">
                    <MenuItem x:Name="OutputMenuItem"
                              Header="_Log Output"
                              Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnShowOutputClick" />
                    <MenuItem x:Name="ShowHideBottomPanelMenuItem"
                              Header="_Show Bottom Panel" InputGestureText="Ctrl+J"
                              Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnToggleBottomPanelClick" />
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem x:Name="ShowHiddenFilesMenuItem"
                          Header="Show _Hidden Files"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsCheckable="True"
                          Click="OnToggleShowHiddenFilesClick" />
            </MenuItem>

            <!-- Playback -->
            <MenuItem Header="_Playback" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="_Play/Pause" InputGestureText="Space"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnPlayPauseClick" />
                <MenuItem Header="_Stop" InputGestureText="S"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnStopClick" />
                <MenuItem Header="Skip _Forward" InputGestureText="Page Down"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnSkipForwardClick" />
                <MenuItem Header="Skip _Backward" InputGestureText="Page Up"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnSkipBackwardClick" />
                <MenuItem Header="_Loop"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnLoopClick" />
                <MenuItem Header="Playback _Speed" Style="{StaticResource SubmenuParentItemStyle}"
                          SubmenuOpened="OnSpeedSubmenuOpened">
                    <MenuItem Header="0.25x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="0.25" />
                    <MenuItem Header="0.5x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="0.5" />
                    <MenuItem Header="0.75x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="0.75" />
                    <MenuItem Header="1x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="1.0" />
                    <MenuItem Header="1.25x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="1.25" />
                    <MenuItem Header="1.5x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="1.5" />
                    <MenuItem Header="2x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="2.0" />
                    <MenuItem Header="4x" Style="{StaticResource DropdownMenuItemStyle}"
                              Click="OnSpeedMenuItemClick" Tag="4.0" />
                </MenuItem>
            </MenuItem>

            <!-- Help -->
            <MenuItem Header="_Help" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="_About Vido"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="_Check for Updates"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- Draggable title area (empty — title is on the Window itself) -->

        <!-- Window Control Buttons -->
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">

            <!-- Minimize -->
            <Button x:Name="MinimizeButton"
                    Command="{Binding MinimizeCommand}"
                    Style="{StaticResource WindowControlButtonStyle}"
                    ToolTip="Minimize">
                <Path Data="M 0,4.5 L 10,4.5"
                      Stroke="{DynamicResource PrimaryForegroundBrush}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="10" Height="10"
                      Stretch="None" />
            </Button>

            <!-- Maximize / Restore -->
            <Button x:Name="MaximizeRestoreButton"
                    Command="{Binding ToggleMaximizeCommand}"
                    Style="{StaticResource WindowControlButtonStyle}"
                    ToolTip="Maximize">
                <!-- Maximize icon (single rectangle) -->
                <Grid x:Name="MaximizeIcon">
                    <Rectangle Width="9" Height="9"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource PrimaryForegroundBrush}"
                               StrokeThickness="1"
                               Fill="Transparent" />
                </Grid>
            </Button>

            <!-- Close -->
            <Button x:Name="CloseButton"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource WindowCloseButtonStyle}"
                    ToolTip="Close">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{DynamicResource PrimaryForegroundBrush}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="10" Height="10"
                      Stretch="None" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
