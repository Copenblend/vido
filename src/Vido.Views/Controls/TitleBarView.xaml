<UserControl x:Class="Vido.Views.Controls.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30"
             Background="{DynamicResource TitleBarBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TitleBarStyles.xaml" />
                <ResourceDictionary Source="../Themes/MenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- App icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Menu bar -->
            <ColumnDefinition Width="Auto" />
            <!-- Draggable title area -->
            <ColumnDefinition Width="*" />
            <!-- Window controls -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- App Icon -->
        <Border Grid.Column="0"
                Width="46"
                Padding="15,0,11,0">
            <TextBlock Text="&#xE714;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="16"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Menu Bar -->
        <Menu Grid.Column="1"
              Style="{StaticResource TitleBarMenuStyle}"
              WindowChrome.IsHitTestVisibleInChrome="True">

            <!-- File -->
            <MenuItem Header="_File" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="Open _Folder..." InputGestureText="Ctrl+Shift+O"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnOpenFolderClick" />
                <MenuItem x:Name="CloseFolderMenuItem" Header="_Close Folder"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsEnabled="False"
                          Click="OnCloseFolderClick" />
                <MenuItem x:Name="RescanFolderMenuItem" Header="_Rescan Folder"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsEnabled="False"
                          Click="OnRescanFolderClick" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="_Recent Files" Style="{StaticResource SubmenuParentItemStyle}">
                    <MenuItem Header="No recent files" Style="{StaticResource DropdownMenuItemStyle}"
                              IsEnabled="False" />
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnExitClick" />
            </MenuItem>

            <!-- Edit -->
            <MenuItem Header="_Edit" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="No actions available"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          IsEnabled="False" />
            </MenuItem>

            <!-- View -->
            <MenuItem Header="_View" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="Toggle _Sidebar" InputGestureText="Ctrl+B"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="Toggle S_tatus Bar"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem x:Name="ToggleBottomPanelMenuItem"
                          Header="Toggle _Bottom Panel" InputGestureText="Ctrl+J"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnToggleBottomPanelClick" />
                <MenuItem x:Name="ToggleRightPanelMenuItem"
                          Header="Toggle _Right Panel"
                          Style="{StaticResource DropdownMenuItemStyle}"
                          Click="OnToggleRightPanelClick" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="_Fullscreen" InputGestureText="F11"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl+="
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
            </MenuItem>

            <!-- Playback -->
            <MenuItem Header="_Playback" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="_Play/Pause" InputGestureText="Space"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="_Stop"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="Skip _Forward"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <MenuItem Header="Skip _Backward"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="_Loop"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="Playback _Speed" Style="{StaticResource SubmenuParentItemStyle}">
                    <MenuItem Header="0.25x" Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                    <MenuItem Header="0.5x" Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                    <MenuItem Header="1.0x" Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                    <MenuItem Header="1.5x" Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                    <MenuItem Header="2.0x" Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                </MenuItem>
            </MenuItem>

            <!-- Help -->
            <MenuItem Header="_Help" Style="{StaticResource TitleBarMenuItemStyle}">
                <MenuItem Header="_About Vido"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="_Check for Updates"
                          Style="{StaticResource DropdownMenuItemStyle}" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- Draggable title area (empty — title is on the Window itself) -->

        <!-- Window Control Buttons -->
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">

            <!-- Minimize -->
            <Button x:Name="MinimizeButton"
                    Command="{Binding MinimizeCommand}"
                    Style="{StaticResource WindowControlButtonStyle}"
                    ToolTip="Minimize">
                <Path Data="M 0,4.5 L 10,4.5"
                      Stroke="{DynamicResource PrimaryForegroundBrush}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="10" Height="10"
                      Stretch="None" />
            </Button>

            <!-- Maximize / Restore -->
            <Button x:Name="MaximizeRestoreButton"
                    Command="{Binding ToggleMaximizeCommand}"
                    Style="{StaticResource WindowControlButtonStyle}"
                    ToolTip="Maximize">
                <!-- Maximize icon (single rectangle) -->
                <Grid x:Name="MaximizeIcon">
                    <Rectangle Width="9" Height="9"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource PrimaryForegroundBrush}"
                               StrokeThickness="1"
                               Fill="Transparent" />
                </Grid>
            </Button>

            <!-- Close -->
            <Button x:Name="CloseButton"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource WindowCloseButtonStyle}"
                    ToolTip="Close">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{DynamicResource PrimaryForegroundBrush}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="10" Height="10"
                      Stretch="None" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
