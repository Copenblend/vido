<UserControl x:Class="Vido.Views.Controls.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30"
             Background="{DynamicResource TitleBarBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TitleBarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- App icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Draggable title area -->
            <ColumnDefinition Width="*" />
            <!-- Window controls -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- App Icon -->
        <Border Grid.Column="0"
                Width="46"
                Padding="15,0,11,0">
            <TextBlock Text="&#xE714;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="16"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Title Text (draggable area) -->
        <TextBlock Grid.Column="1"
                   Text="{Binding Title}"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="0,0,0,0" />

        <!-- Window Control Buttons -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">

            <!-- Minimize -->
            <Button x:Name="MinimizeButton"
                    Command="{Binding MinimizeCommand}"
                    Style="{StaticResource WindowControlButtonStyle}"
                    ToolTip="Minimize">
                <Path Data="M 0,4.5 L 10,4.5"
                      Stroke="{DynamicResource PrimaryForegroundBrush}"
                      StrokeThickness="1"
                      Width="10" Height="10"
                      Stretch="None" />
            </Button>

            <!-- Maximize / Restore -->
            <Button x:Name="MaximizeRestoreButton"
                    Command="{Binding ToggleMaximizeCommand}"
                    Style="{StaticResource WindowControlButtonStyle}"
                    ToolTip="Maximize">
                <!-- Maximize icon (single rectangle) -->
                <Grid x:Name="MaximizeIcon">
                    <Rectangle Width="9" Height="9"
                               Stroke="{DynamicResource PrimaryForegroundBrush}"
                               StrokeThickness="1"
                               Fill="Transparent" />
                </Grid>
            </Button>

            <!-- Close -->
            <Button x:Name="CloseButton"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource WindowCloseButtonStyle}"
                    ToolTip="Close">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{DynamicResource PrimaryForegroundBrush}"
                      StrokeThickness="1"
                      Width="10" Height="10"
                      Stretch="None" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
