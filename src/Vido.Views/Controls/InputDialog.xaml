<Window x:Class="Vido.Views.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Width="450" Height="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown"
        Loaded="OnLoaded">

    <Border Background="{StaticResource EditorBackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Prompt text -->
                <RowDefinition Height="12" />     <!-- Spacer -->
                <RowDefinition Height="Auto" />  <!-- Input box -->
                <RowDefinition Height="*" />      <!-- Flex spacer -->
                <RowDefinition Height="Auto" />  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Prompt -->
            <TextBlock Grid.Row="0"
                       x:Name="PromptText"
                       FontSize="13"
                       Foreground="{StaticResource PrimaryForegroundBrush}"
                       TextWrapping="Wrap" />

            <!-- Input -->
            <TextBox Grid.Row="2"
                     x:Name="InputBox"
                     FontSize="13"
                     Padding="6,4"
                     Foreground="{StaticResource PrimaryForegroundBrush}"
                     Background="{StaticResource InputBackgroundBrush}"
                     BorderBrush="{StaticResource PrimaryBorderBrush}"
                     BorderThickness="1"
                     CaretBrush="{StaticResource PrimaryForegroundBrush}" />

            <!-- Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="OK"
                        Width="80" Height="28"
                        Margin="0,0,8,0"
                        Click="OnOkClick"
                        IsDefault="True"
                        FontSize="13"
                        Foreground="{StaticResource ActiveIconBrush}"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Cancel"
                        Width="80" Height="28"
                        Click="OnCancelClick"
                        IsCancel="True"
                        FontSize="13"
                        Foreground="{StaticResource SecondaryForegroundBrush}"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
