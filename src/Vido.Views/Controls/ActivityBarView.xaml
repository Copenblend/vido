<UserControl x:Class="Vido.Views.Controls.ActivityBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48"
             Background="{DynamicResource ActivityBarBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LayoutStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="False">
        <!-- Top group: Explorer, Extensions, then plugin buttons -->
        <StackPanel DockPanel.Dock="Top">
            <!-- Explorer (VS Code codicon: files) -->
            <Button x:Name="ExplorerButton"
                    Style="{StaticResource ActivityBarButtonStyle}"
                    ToolTip="Explorer"
                    Click="OnExplorerClick">
                <Canvas Width="24" Height="24">
                    <!-- Back page -->
                    <Rectangle Canvas.Left="6" Canvas.Top="2" Width="14" Height="18"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource ActiveIconBrush}"
                               StrokeThickness="1.2" Fill="Transparent" />
                    <!-- Front page -->
                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="14" Height="18"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource ActiveIconBrush}"
                               StrokeThickness="1.2"
                               Fill="{DynamicResource ActivityBarBackgroundBrush}" />
                    <!-- Lines on front page -->
                    <Line Canvas.Left="7" Canvas.Top="9" X2="8" Y2="0"
                          Stroke="{DynamicResource ActiveIconBrush}" StrokeThickness="1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line Canvas.Left="7" Canvas.Top="12" X2="8" Y2="0"
                          Stroke="{DynamicResource ActiveIconBrush}" StrokeThickness="1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line Canvas.Left="7" Canvas.Top="15" X2="5" Y2="0"
                          Stroke="{DynamicResource ActiveIconBrush}" StrokeThickness="1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Button>

            <!-- Extensions — Symmetric 2×2 puzzle icon (centered at 12,12) -->
            <Button x:Name="ExtensionsButton"
                    Style="{StaticResource ActivityBarButtonStyle}"
                    ToolTip="Extensions"
                    Click="OnExtensionsClick">
                <Canvas Width="24" Height="24">
                    <!-- Top-left piece -->
                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="8" Height="8"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource InactiveIconBrush}"
                               StrokeThickness="1.2" Fill="Transparent" />
                    <!-- Top-right piece -->
                    <Rectangle Canvas.Left="13" Canvas.Top="3" Width="8" Height="8"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource InactiveIconBrush}"
                               StrokeThickness="1.2" Fill="Transparent" />
                    <!-- Bottom-left piece -->
                    <Rectangle Canvas.Left="3" Canvas.Top="13" Width="8" Height="8"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource InactiveIconBrush}"
                               StrokeThickness="1.2" Fill="Transparent" />
                    <!-- Bottom-right piece -->
                    <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8"
                               RadiusX="1.5" RadiusY="1.5"
                               Stroke="{DynamicResource InactiveIconBrush}"
                               StrokeThickness="1.2" Fill="Transparent" />
                    <!-- Center connection nubs (horizontal) -->
                    <Rectangle Canvas.Left="10" Canvas.Top="6" Width="4" Height="2"
                               RadiusX="0.5" RadiusY="0.5"
                               Fill="{DynamicResource InactiveIconBrush}" />
                    <Rectangle Canvas.Left="10" Canvas.Top="16" Width="4" Height="2"
                               RadiusX="0.5" RadiusY="0.5"
                               Fill="{DynamicResource InactiveIconBrush}" />
                    <!-- Center connection nubs (vertical) -->
                    <Rectangle Canvas.Left="6" Canvas.Top="10" Width="2" Height="4"
                               RadiusX="0.5" RadiusY="0.5"
                               Fill="{DynamicResource InactiveIconBrush}" />
                    <Rectangle Canvas.Left="16" Canvas.Top="10" Width="2" Height="4"
                               RadiusX="0.5" RadiusY="0.5"
                               Fill="{DynamicResource InactiveIconBrush}" />
                </Canvas>
            </Button>

            <!-- OSR2+ sidebar button — uses embedded connect icon -->
            <Button x:Name="Osr2PlusButton"
                    Style="{StaticResource ActivityBarButtonStyle}"
                    ToolTip="OSR2+"
                    Click="OnOsr2PlusClick">
                <Image Source="pack://application:,,,/Vido.Views;component/Assets/Osr2Plus/sidebar-icon.png"
                       Width="24" Height="24"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       Opacity="0.6" />
            </Button>

            <!-- Pulse sidebar button — uses embedded Pulse icon -->
            <Button x:Name="PulseButton"
                    Style="{StaticResource ActivityBarButtonStyle}"
                    ToolTip="Pulse"
                    Click="OnPulseClick">
                <Image Source="pack://application:,,,/Vido.Views;component/Assets/Pulse/sidebar-icon.png"
                       Width="24" Height="24"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       Opacity="0.6" />
            </Button>

            <!-- Playlists sidebar button — uses embedded Playlists icon -->
            <Button x:Name="PlaylistsButton"
                    Style="{StaticResource ActivityBarButtonStyle}"
                    ToolTip="Playlists"
                    Click="OnPlaylistsClick">
                <Image Source="pack://application:,,,/Vido.Views;component/Assets/Playlists/sidebar-icon.png"
                       Width="24" Height="24"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       Opacity="0.6" />
            </Button>

            <!-- Plugin sidebar buttons — separate container for drag-and-drop reordering (vb-007) -->
            <StackPanel x:Name="PluginButtonsPanel"
                        AllowDrop="True"
                        DragOver="OnPluginDragOver"
                        Drop="OnPluginDrop" />
        </StackPanel>

        <!-- Bottom group: Settings -->
        <StackPanel DockPanel.Dock="Bottom">
            <!-- Settings (VS Code codicon: gear) -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource ActivityBarButtonStyle}"
                    ToolTip="Settings"
                    Click="OnSettingsClick">
                <Canvas Width="24" Height="24">
                    <Path Data="M 12,2 L 13.4,2 L 14,4.4 L 16.2,5.4 L 18.4,4.2 L 19.8,5.6 L 18.6,7.8 L 19.6,10 L 22,10.6 L 22,12 L 19.6,12.6 L 18.6,14.8 L 19.8,17 L 18.4,18.4 L 16.2,17.2 L 14,18.2 L 13.4,20.6 L 12,20.6 L 11.4,18.2 L 9.2,17.2 L 7,18.4 L 5.6,17 L 6.8,14.8 L 5.8,12.6 L 3.4,12 L 3.4,10.6 L 5.8,10 L 6.8,7.8 L 5.6,5.6 L 7,4.2 L 9.2,5.4 L 11.4,4.4 Z"
                          Stroke="{DynamicResource InactiveIconBrush}"
                          StrokeThickness="1.2" Fill="Transparent"
                          StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="9.2" Canvas.Top="7.8" Width="7" Height="7"
                             Stroke="{DynamicResource InactiveIconBrush}"
                             StrokeThickness="1.2" Fill="Transparent" />
                </Canvas>
            </Button>
        </StackPanel>
    </DockPanel>
</UserControl>
