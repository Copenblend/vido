<UserControl x:Class="Vido.Views.Controls.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Vido.Core.Layout;assembly=Vido.Core"
             Height="22"
             Background="{DynamicResource StatusBarBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Status bar item text style -->
            <Style x:Key="StatusBarItemStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#ffffff" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- Separator dot between right-side items -->
            <Style x:Key="StatusBarSeparatorStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="3" />
                <Setter Property="Fill" Value="#99ffffff" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Top border line to separate status bar from content -->
    <Grid>
        <Border VerticalAlignment="Top" Height="1"
                Background="{DynamicResource PrimaryBorderBrush}" />

        <DockPanel Margin="0,1,0,0">
            <!-- Left-aligned items -->
            <ItemsControl DockPanel.Dock="Left"
                          ItemsSource="{Binding LeftItems}"
                          Margin="10,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type layout:StatusBarItem}">
                        <TextBlock Text="{Binding Text}"
                                   ToolTip="{Binding Tooltip}"
                                   Style="{StaticResource StatusBarItemStyle}"
                                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,12,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Right-aligned items -->
            <ItemsControl DockPanel.Dock="Right"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding RightItems}"
                          Margin="0,0,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type layout:StatusBarItem}">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <!-- Separator dot (hidden for first right item via DataTrigger) -->
                            <Ellipse x:Name="Separator"
                                     Style="{StaticResource StatusBarSeparatorStyle}" />
                            <TextBlock Text="{Binding Text}"
                                       ToolTip="{Binding Tooltip}"
                                       Style="{StaticResource StatusBarItemStyle}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <!-- Hide separator for the first item (Priority 100 = Duration, the first right item) -->
                            <DataTrigger Binding="{Binding Priority}" Value="100">
                                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Spacer to fill remaining -->
            <Border />
        </DockPanel>
    </Grid>
</UserControl>
