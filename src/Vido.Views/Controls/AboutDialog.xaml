<Window x:Class="Vido.Views.Controls.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Vido"
        Width="420" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown">

    <Border Background="{StaticResource EditorBackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Logo + title -->
                <RowDefinition Height="Auto" />  <!-- Tagline -->
                <RowDefinition Height="16" />     <!-- Spacer -->
                <RowDefinition Height="Auto" />  <!-- Version info -->
                <RowDefinition Height="*" />      <!-- Flex spacer -->
                <RowDefinition Height="Auto" />  <!-- OK button -->
            </Grid.RowDefinitions>

            <!-- Logo and app name -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Vido.Views;component/Assets/Vido.png"
                       Width="48" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center" />
                <TextBlock Text="Vido"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Tagline -->
            <TextBlock Grid.Row="1"
                       Text="Ultra-Performant Video Player"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />

            <!-- Version info grid -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>

                    <!-- Version -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Version"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               x:Name="VersionText"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />

                    <!-- .NET -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text=".NET Runtime"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               x:Name="DotNetVersionText"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />

                    <!-- FFmpeg -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="FFmpeg"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               x:Name="FFmpegVersionText"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- OK Button -->
            <Button Grid.Row="5"
                    Content="OK"
                    Width="80" Height="28"
                    HorizontalAlignment="Center"
                    Click="OnOkClick"
                    IsDefault="True"
                    FontSize="13"
                    Foreground="{StaticResource ActiveIconBrush}"
                    Cursor="Hand"
                    ToolTip="Close">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
