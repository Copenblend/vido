<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- VS Code Dark Modern — Color Palette -->
    <!-- Source of truth: https://github.com/microsoft/vscode/blob/main/extensions/theme-defaults/themes/dark_modern.json -->

    <!-- Backgrounds -->
    <Color x:Key="EditorBackgroundColor">#1f1f1f</Color>
    <Color x:Key="SidebarBackgroundColor">#181818</Color>
    <Color x:Key="ActivityBarBackgroundColor">#181818</Color>
    <Color x:Key="TitleBarBackgroundColor">#181818</Color>
    <Color x:Key="StatusBarBackgroundColor">#007acc</Color>  <!-- Uses AccentColor value -->
    <Color x:Key="PanelBackgroundColor">#181818</Color>
    <Color x:Key="InputBackgroundColor">#313131</Color>
    <Color x:Key="DropdownBackgroundColor">#313131</Color>
    <Color x:Key="TabActiveBackgroundColor">#1f1f1f</Color>
    <Color x:Key="TabInactiveBackgroundColor">#181818</Color>
    <Color x:Key="MenuBackgroundColor">#2f2f2f</Color>
    <Color x:Key="HoverBackgroundColor">#2a2d2e</Color>
    <Color x:Key="SelectionBackgroundColor">#04395e</Color>
    <Color x:Key="ButtonBackgroundColor">#0078d4</Color>
    <Color x:Key="ButtonHoverBackgroundColor">#026ec1</Color>
    <Color x:Key="ScrollbarBackgroundColor">#4a4a4a80</Color>
    <Color x:Key="ContextMenuBackgroundColor">#1f1f1f</Color>

    <!-- Window Control Hover Colors -->
    <Color x:Key="WindowControlHoverBackgroundColor">#3d3d3d</Color>
    <Color x:Key="WindowCloseHoverBackgroundColor">#c42b1c</Color>

    <!-- Foregrounds -->
    <Color x:Key="PrimaryForegroundColor">#cccccc</Color>
    <Color x:Key="SecondaryForegroundColor">#9d9d9d</Color>
    <Color x:Key="DisabledForegroundColor">#6b6b6b</Color>
    <Color x:Key="ActiveIconColor">#ffffff</Color>
    <Color x:Key="InactiveIconColor">#9d9d9d</Color>
    <Color x:Key="LinkForegroundColor">#4fc1ff</Color>
    <Color x:Key="ErrorForegroundColor">#f44747</Color>
    <Color x:Key="WarningForegroundColor">#cca700</Color>
    <Color x:Key="SuccessForegroundColor">#89d185</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#007acc</Color>

    <!-- Borders -->
    <Color x:Key="PrimaryBorderColor">#2b2b2b</Color>
    <Color x:Key="FocusBorderColor">#007fd4</Color>
    <Color x:Key="ActiveTabBorderColor">#007acc</Color>
    <Color x:Key="PanelSeparatorColor">#2b2b2b</Color>

</ResourceDictionary>
