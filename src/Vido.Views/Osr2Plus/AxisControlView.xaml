<UserControl x:Class="Vido.Views.Osr2Plus.AxisControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vido.Views.Osr2Plus">

    <!-- DataContext is expected to be AxisControlViewModel -->

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource Osr2ScrollViewerStyle}"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="#1E1E1E">
        <StackPanel Margin="8">

            <!-- Panel Header -->
            <TextBlock Text="AXIS CONTROL"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,4,0,8" />

            <!-- Profile Selection -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Profile"
                           Foreground="#999999"
                           FontSize="11"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,8,0"/>

                <!-- Action Buttons (right-docked) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                    <TextBlock Text="(modified)"
                               Foreground="#CC9900"
                               FontSize="10"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Visibility="{Binding IsProfileModified, Converter={StaticResource BoolToVisibility}}"/>
                    <Button ToolTip="Save current settings as new profile"
                            Command="{Binding SaveProfileCommand}"
                            Style="{StaticResource Osr2SmallButtonStyle}"
                            Width="26" Height="26" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Content="&#xE710;"/>
                    <Button ToolTip="Rename selected profile"
                            Command="{Binding RenameProfileCommand}"
                            Style="{StaticResource Osr2SmallButtonStyle}"
                            Width="26" Height="26" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Content="&#xE70F;"
                            Margin="2,0,0,0"
                            Visibility="{Binding CanRenameSelectedProfile, Converter={StaticResource BoolToVisibility}}"/>
                    <Button ToolTip="Delete selected profile"
                            Command="{Binding DeleteProfileCommand}"
                            Style="{StaticResource Osr2SmallButtonStyle}"
                            Width="26" Height="26" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Content="&#xE74D;"
                            Margin="2,0,0,0"
                            Visibility="{Binding CanDeleteSelectedProfile, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- ComboBox fills remaining space -->
                <ComboBox Style="{StaticResource Osr2ComboBoxStyle}"
                          ItemContainerStyle="{StaticResource Osr2ComboBoxItemStyle}"
                          ItemsSource="{Binding AvailableProfiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!-- Axis Cards -->
            <ItemsControl ItemsSource="{Binding AxisCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:AxisCardView Margin="0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Test Button -->
            <Button Content="{Binding TestButtonText}"
                    Command="{Binding TestCommand}"
                    IsEnabled="{Binding IsTestEnabled}"
                    HorizontalAlignment="Stretch"
                    ToolTipService.ShowOnDisabled="True"
                    Margin="0,10,0,4">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Osr2TestButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="ToolTip" Value="Connect device to test" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
