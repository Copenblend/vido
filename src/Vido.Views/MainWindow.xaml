<Window x:Class="Vido.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vido.Views.Controls"
        Title="Vido"
        Width="2560"
        Height="720"
        WindowStyle="None"
        Background="{DynamicResource EditorBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Controls/LayoutStyles.xaml" />
                <ResourceDictionary Source="Controls/TabStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="30" />
                <!-- Content area (activity bar + sidebar + editor) -->
                <RowDefinition Height="*" />
                <!-- Status bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <controls:TitleBarView x:Name="TitleBar" Grid.Row="0" />

            <!-- Divider between title bar and content -->
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource PrimaryBorderBrush}" />

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Activity bar -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Sidebar -->
                    <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="170" MaxWidth="600" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Editor + panels area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Activity Bar -->
                <controls:ActivityBarView x:Name="ActivityBar"
                                          Grid.Column="0"
                                          PanelChanged="OnPanelChanged" />

                <!-- Divider between activity bar and sidebar -->
                <Border x:Name="ActivityBarDivider" Grid.Column="0"
                        HorizontalAlignment="Right"
                        Width="1"
                        Background="{DynamicResource PrimaryBorderBrush}" />

                <!-- Sidebar -->
                <controls:SidebarView x:Name="Sidebar"
                                      Grid.Column="1" />

                <!-- Splitter between sidebar and editor -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="2"
                              Style="{StaticResource VerticalSplitterStyle}" />

                <!-- Editor + Right Panel area -->
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <!-- Editor + bottom panel -->
                        <ColumnDefinition Width="*" />
                        <!-- Right panel splitter -->
                        <ColumnDefinition x:Name="RightPanelSplitterColumn" Width="Auto" />
                        <!-- Right panel -->
                        <ColumnDefinition x:Name="RightPanelColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <!-- Editor (tabs + content) + Bottom Panel -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <!-- Tab strip + tab content -->
                            <RowDefinition Height="*" />
                            <!-- Bottom panel splitter -->
                            <RowDefinition x:Name="BottomPanelSplitterRow" Height="Auto" />
                            <!-- Bottom panel -->
                            <RowDefinition x:Name="BottomPanelRow" Height="0" />
                        </Grid.RowDefinitions>

                        <!-- Editor area: tab strip + content -->
                        <Grid Grid.Row="0"
                              Background="{DynamicResource EditorBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <!-- Tab strip -->
                                <RowDefinition Height="Auto" />
                                <!-- Tab content -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tab Well -->
                            <controls:TabWell x:Name="TabWell" Grid.Row="0" />

                            <!-- Tab content area — shows the active tab's content -->
                            <Grid x:Name="TabContentArea" Grid.Row="1">
                                <!-- Video player (always present, visibility toggled) -->
                                <controls:VideoPlayerControl x:Name="VideoPlayer" />

                                <!-- Dynamic tab content host (Settings, etc.) -->
                                <ContentPresenter x:Name="DynamicTabContent"
                                                  Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                        <!-- Bottom panel splitter -->
                        <GridSplitter x:Name="BottomPanelSplitter"
                                      Grid.Row="1"
                                      Style="{StaticResource HorizontalSplitterStyle}"
                                      Visibility="Collapsed" />

                        <!-- Bottom panel -->
                        <Border x:Name="BottomPanel"
                                Grid.Row="2"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Panel tab strip -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Panel content -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Bottom panel tab strip -->
                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelTabStripStyle}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="OUTPUT"
                                                   Style="{StaticResource PanelTabItemStyle}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Bottom panel content (stub) -->
                                <Border Grid.Row="1"
                                        Padding="12,8">
                                    <TextBlock Text="Output log will be available in a future update."
                                               Foreground="{DynamicResource DisabledForegroundBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right panel splitter -->
                    <GridSplitter x:Name="RightPanelSplitter"
                                  Grid.Column="1"
                                  Style="{StaticResource VerticalSplitterStyle}"
                                  Visibility="Collapsed" />

                    <!-- Right panel -->
                    <Border x:Name="RightPanel"
                            Grid.Column="2"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Panel tab strip -->
                                <RowDefinition Height="Auto" />
                                <!-- Panel content -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Right panel tab strip -->
                            <Border Grid.Row="0"
                                    Style="{StaticResource PanelTabStripStyle}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="VIDEO INFO"
                                               Style="{StaticResource PanelTabItemStyle}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Right panel content (stub) -->
                            <Border Grid.Row="1"
                                    Padding="12,8">
                                <TextBlock Text="Video details will be available in a future update."
                                           Foreground="{DynamicResource DisabledForegroundBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <controls:StatusBarView Grid.Row="2" />
        </Grid>
    </Border>
</Window>
