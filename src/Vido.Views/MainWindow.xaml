<Window x:Class="Vido.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vido.Views.Controls"
        Title="Vido"
        Width="1280"
        Height="720"
        WindowStyle="None"
        Background="{DynamicResource EditorBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Controls/LayoutStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="30" />
                <!-- Content area (activity bar + sidebar + editor) -->
                <RowDefinition Height="*" />
                <!-- Status bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <controls:TitleBarView x:Name="TitleBar" Grid.Row="0" />

            <!-- Divider between title bar and content -->
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource PrimaryBorderBrush}" />

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Activity bar -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Sidebar -->
                    <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="170" MaxWidth="600" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Editor area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Activity Bar -->
                <controls:ActivityBarView x:Name="ActivityBar"
                                          Grid.Column="0"
                                          PanelChanged="OnPanelChanged" />

                <!-- Divider between activity bar and sidebar -->
                <Border x:Name="ActivityBarDivider" Grid.Column="0"
                        HorizontalAlignment="Right"
                        Width="1"
                        Background="{DynamicResource PrimaryBorderBrush}" />

                <!-- Sidebar -->
                <controls:SidebarView x:Name="Sidebar"
                                      Grid.Column="1" />

                <!-- Splitter between sidebar and editor -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="2"
                              Style="{StaticResource VerticalSplitterStyle}" />

                <!-- Editor Area -->
                <Grid Grid.Column="3"
                      Background="{DynamicResource EditorBackgroundBrush}">
                    <TextBlock Text="Open a video file to begin"
                               Foreground="{DynamicResource DisabledForegroundBrush}"
                               FontSize="16"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <controls:StatusBarView Grid.Row="2" />
        </Grid>
    </Border>
</Window>
