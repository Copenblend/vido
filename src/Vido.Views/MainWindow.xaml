<Window x:Class="Vido.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vido.Views.Controls"
        Title="Vido"
        Width="2560"
        Height="720"
        WindowStyle="None"
        Background="{DynamicResource EditorBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Controls/LayoutStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="30" />
                <!-- Content area (activity bar + sidebar + editor) -->
                <RowDefinition Height="*" />
                <!-- Status bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <controls:TitleBarView x:Name="TitleBar" Grid.Row="0" />

            <!-- Divider between title bar and content -->
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource PrimaryBorderBrush}" />

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Activity bar -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Sidebar -->
                    <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="170" MaxWidth="600" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Editor area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Activity Bar -->
                <controls:ActivityBarView x:Name="ActivityBar"
                                          Grid.Column="0"
                                          PanelChanged="OnPanelChanged" />

                <!-- Divider between activity bar and sidebar -->
                <Border x:Name="ActivityBarDivider" Grid.Column="0"
                        HorizontalAlignment="Right"
                        Width="1"
                        Background="{DynamicResource PrimaryBorderBrush}" />

                <!-- Sidebar -->
                <controls:SidebarView x:Name="Sidebar"
                                      Grid.Column="1" />

                <!-- Splitter between sidebar and editor -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="2"
                              Style="{StaticResource VerticalSplitterStyle}" />

                <!-- Editor Area -->
                <Grid Grid.Column="3"
                      Background="{DynamicResource EditorBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Tab strip -->
                        <RowDefinition Height="Auto" />
                        <!-- Tab content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab strip -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource TabInactiveBackgroundBrush}"
                            BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <!-- Player tab — always leftmost, no close button -->
                            <Border x:Name="PlayerTab"
                                    Height="35"
                                    Padding="12,0"
                                    Background="{DynamicResource EditorBackgroundBrush}"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OnPlayerTabClick">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Path Data="M 4,2 L 4,18 L 18,10 Z"
                                          Fill="{DynamicResource SecondaryForegroundBrush}"
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Player"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Active tab bottom accent line -->
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="0" />
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Active tab bottom border (accent line under active tab) -->
                    <Border Grid.Row="0"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Width="{Binding ActualWidth, ElementName=PlayerTab}"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}" />

                    <!-- Tab content area -->
                    <controls:VideoPlayerControl x:Name="VideoPlayer"
                                                 Grid.Row="1" />
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <controls:StatusBarView Grid.Row="2" />
        </Grid>
    </Border>
</Window>
