<UserControl x:Class="Vido.Views.Panels.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource EditorBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <!-- Gear icon -->
            <Path Data="M 10,0 L 12,0 L 13,3 L 15.5,1.5 L 17,3 L 15,5.5 L 18,6.5 L 18,8.5 L 15,9.5 L 17,12 L 15.5,13.5 L 13,12 L 12,15 L 10,15 L 9,12 L 6.5,13.5 L 5,12 L 7,9.5 L 4,8.5 L 4,6.5 L 7,5.5 L 5,3 L 6.5,1.5 L 9,3 Z"
                  Stroke="{DynamicResource DisabledForegroundBrush}"
                  StrokeThickness="1"
                  Fill="Transparent"
                  Stretch="Uniform"
                  Width="48" Height="48"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,16" />
            <TextBlock Text="Settings will be available in a future update"
                       Foreground="{DynamicResource DisabledForegroundBrush}"
                       FontSize="16"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
