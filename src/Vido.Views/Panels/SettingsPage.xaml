<UserControl x:Class="Vido.Views.Panels.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Vido.Views.Converters"
             Background="{DynamicResource EditorBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Brushes.xaml" />
                <ResourceDictionary Source="../Themes/SettingsControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />

            <!-- Search TextBox Style -->
            <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <!-- Search icon -->
                                    <Path Data="M 10,0 A 5,5 0 1 0 10,10 A 5,5 0 1 0 10,0 M 14,14 L 18,18"
                                          Stroke="{DynamicResource SecondaryForegroundBrush}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0" />
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  Margin="28,6,8,6"
                                                  VerticalAlignment="Center" />
                                    <!-- Placeholder -->
                                    <TextBlock x:Name="PlaceholderText"
                                               Text="Search settings..."
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               FontFamily="Segoe UI" FontSize="13"
                                               IsHitTestVisible="False"
                                               Margin="28,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush"
                                            Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush"
                                            Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Category header style -->
            <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- Setting title style -->
            <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!-- Setting description style -->
            <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0" Padding="24,16,24,8">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     MaxWidth="600"
                     HorizontalAlignment="Stretch"
                     TextChanged="OnSearchTextChanged" />
        </Border>

        <!-- Settings list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel Margin="24,8,24,24" MaxWidth="600" HorizontalAlignment="Left">

                <!-- No results message -->
                <TextBlock x:Name="NoResultsText"
                           Text="No settings found matching your search."
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           FontFamily="Segoe UI" FontSize="13"
                           Visibility="Collapsed"
                           Margin="0,8,0,0" />

                <!-- Categories list -->
                <ItemsControl x:Name="CategoriesControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <!-- Category header with separator -->
                                <Border Margin="0,8,0,12">
                                    <StackPanel>
                                        <Border Height="1"
                                                Background="{DynamicResource PanelSeparatorBrush}"
                                                Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Plugin icon for plugin categories -->
                                            <Path Data="M 14.5,2 L 12,4.5 L 9.5,2 L 5,2 L 5,13 L 9.5,13 L 12,15.5 L 14.5,13 L 19,13 L 19,2 Z"
                                                  Stroke="{DynamicResource SecondaryForegroundBrush}"
                                                  StrokeThickness="1"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"
                                                  Width="14" Height="14"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsPlugin, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource CategoryHeaderStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Settings within the category -->
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16"
                                                        Visibility="{Binding IsSettingVisible, Converter={StaticResource BoolToVis}}">
                                                <!-- Setting title -->
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource SettingTitleStyle}" />

                                                <!-- Setting description -->
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource SettingDescriptionStyle}" />

                                                <!-- Boolean → CheckBox -->
                                                <CheckBox IsChecked="{Binding SelectedBooleanValue, Converter={StaticResource StringToBoolConverter}}"
                                                          Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}"
                                                          Style="{StaticResource SettingsCheckBoxStyle}" />

                                                <!-- Number → TextBox (numeric only) -->
                                                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}"
                                                         Width="120" HorizontalAlignment="Left"
                                                         Style="{StaticResource SettingsTextBoxStyle}"
                                                         PreviewTextInput="OnNumericPreviewTextInput" />

                                                <!-- String → TextBox -->
                                                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsString, Converter={StaticResource BoolToVis}}"
                                                         Width="400" HorizontalAlignment="Left"
                                                         Style="{StaticResource SettingsTextBoxStyle}" />

                                                <!-- FolderPath → TextBox + Browse button -->
                                                <Grid Visibility="{Binding IsFolderPath, Converter={StaticResource BoolToVis}}"
                                                      HorizontalAlignment="Left" Width="480">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             IsReadOnly="True" />
                                                    <Button Grid.Column="1"
                                                            Content="Browse..."
                                                            Margin="6,0,0,0"
                                                            Padding="12,4"
                                                            Cursor="Hand"
                                                            Click="OnBrowseFolderClick">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="FontFamily" Value="Segoe UI" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="3"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>

                                                <!-- Enum → ComboBox -->
                                                <ComboBox ItemsSource="{Binding EnumValues}"
                                                          SelectedItem="{Binding SelectedEnumValue}"
                                                          Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}"
                                                          Width="200" HorizontalAlignment="Left"
                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}" />

                                                <!-- StringList → List with add/remove -->
                                                <StackPanel Visibility="{Binding IsStringList, Converter={StaticResource BoolToVis}}"
                                                            HorizontalAlignment="Left" Width="480">
                                                    <!-- Existing items -->
                                                    <ItemsControl ItemsSource="{Binding ListItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,4"
                                                                        Background="{DynamicResource InputBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        Padding="8,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding}"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                                   FontFamily="Segoe UI" FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="1"
                                                                                Content="✕"
                                                                                FontSize="10"
                                                                                Width="22" Height="22"
                                                                                Padding="0"
                                                                                VerticalAlignment="Center"
                                                                                Click="OnRemoveListItem"
                                                                                Tag="{Binding}"
                                                                                Cursor="Hand">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button">
                                                                                    <Setter Property="Background" Value="Transparent" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="Button">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        CornerRadius="3">
                                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                                      VerticalAlignment="Center" />
                                                                                                </Border>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                                                                            <Setter Property="Background" Value="#30FFFFFF" />
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Add new item row -->
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding NewListItemText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource SettingsTextBoxStyle}"
                                                                 KeyDown="OnAddListItemKeyDown" />
                                                        <Button Grid.Column="1"
                                                                Content="Add"
                                                                Margin="6,0,0,0"
                                                                Padding="12,4"
                                                                Click="OnAddListItemClick"
                                                                Cursor="Hand">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                                    <Setter Property="FontSize" Value="12" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="3"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                      VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Validation error message -->
                                                    <TextBlock Text="{Binding ValidationError}"
                                                               Foreground="{DynamicResource ErrorForegroundBrush}"
                                                               FontFamily="Segoe UI" FontSize="11"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding ValidationError, Converter={StaticResource StringToVis}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
