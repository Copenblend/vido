<UserControl x:Class="Vido.Views.Panels.FileExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fs="clr-namespace:Vido.Core.FileSystem;assembly=Vido.Core">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/TreeViewStyles.xaml" />
                <ResourceDictionary Source="../Themes/ContextMenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Context menu for video file nodes -->
            <ContextMenu x:Key="VideoFileContextMenu"
                         Style="{StaticResource DarkContextMenuStyle}">
                <MenuItem Header="Play"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnPlayFileClick" />
                <MenuItem Header="Hide from View"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnHideFileClick" />
                <MenuItem Header="Reveal in File Explorer"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnRevealInExplorerClick" />
            </ContextMenu>

            <!-- Context menu for non-video file nodes -->
            <ContextMenu x:Key="NonVideoFileContextMenu"
                         Style="{StaticResource DarkContextMenuStyle}">
                <MenuItem Header="Hide from View"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnHideFileClick" />
                <MenuItem Header="Reveal in File Explorer"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnRevealInExplorerClick" />
            </ContextMenu>

            <!-- Context menu for folder nodes -->
            <ContextMenu x:Key="FolderContextMenu"
                         Style="{StaticResource DarkContextMenuStyle}">
                <MenuItem Header="Hide from View"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnHideFileClick" />
                <MenuItem Header="Reveal in File Explorer"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnRevealInExplorerClick" />
            </ContextMenu>

            <!-- Context menu for hidden file/folder nodes -->
            <ContextMenu x:Key="HiddenNodeContextMenu"
                         Style="{StaticResource DarkContextMenuStyle}">
                <MenuItem Header="Unhide"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnUnhideFileClick" />
                <MenuItem Header="Reveal in File Explorer"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnRevealInExplorerClick" />
            </ContextMenu>

            <!-- Context menu for tree background -->
            <ContextMenu x:Key="TreeBackgroundContextMenu"
                         Style="{StaticResource DarkContextMenuStyle}">
                <MenuItem Header="Open Folder..."
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnContextOpenFolderClick" />
                <MenuItem x:Name="ContextCloseFolder"
                          Header="Close Folder"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnContextCloseFolderClick" />
                <MenuItem Header="Rescan Folder"
                          Style="{StaticResource ContextMenuItemStyle}"
                          Click="OnContextRescanFolderClick" />
                <MenuItem x:Name="ContextShowHiddenFiles"
                          Header="Show Hidden Files"
                          Style="{StaticResource ContextMenuItemStyle}"
                          IsCheckable="True"
                          Click="OnToggleShowHiddenFilesClick" />
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state: no folder open -->
        <StackPanel x:Name="EmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="16,40,16,0"
                    Visibility="Visible">
            <TextBlock Text="You have not yet opened a folder."
                       Foreground="{DynamicResource DisabledForegroundBrush}"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <Button x:Name="OpenFolderButton"
                    Content="Open Folder"
                    Margin="0,12,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnOpenFolderButtonClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background"
                                        Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Folder open state: tree view -->
        <DockPanel x:Name="TreePanel" Visibility="Collapsed"
                   ContextMenu="{StaticResource TreeBackgroundContextMenu}">
            <!-- Folder name section header -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    Padding="0">
                <TextBlock x:Name="FolderHeader"
                           Text="{Binding FolderName}"
                           Style="{StaticResource FolderSectionHeaderStyle}" />
            </Border>

            <!-- Tree view -->
            <TreeView x:Name="FileTree"
                      ItemsSource="{Binding RootNodes}"
                      Style="{StaticResource FileExplorerTreeViewStyle}"
                      ContextMenu="{StaticResource TreeBackgroundContextMenu}"
                      TreeViewItem.Expanded="OnTreeViewItemExpanded"
                      TreeViewItem.Selected="OnTreeViewItemSelected">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource FileExplorerTreeViewItemStyle}">
                        <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnTreeItemPreviewRightClick" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnTreeItemDoubleClick" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type fs:FileNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel x:Name="NodeRow"
                                    Orientation="Horizontal" Margin="2,0,8,0">
                            <!-- Video file icon -->
                            <Canvas x:Name="VideoIcon"
                                    Width="16" Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Path Data="{StaticResource VideoFileGeometry}"
                                      Stroke="{StaticResource VideoIconBrush}"
                                      StrokeThickness="1"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="16" Height="16" />
                                <Path Data="{StaticResource VideoPlayOverlay}"
                                      Fill="{StaticResource VideoIconBrush}"
                                      Stretch="Uniform"
                                      Width="16" Height="16" />
                            </Canvas>

                            <!-- Generic file icon -->
                            <Path x:Name="GenericFileIcon"
                                  Data="{StaticResource GenericFileGeometry}"
                                  Stroke="{StaticResource GenericFileIconBrush}"
                                  StrokeThickness="1"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Width="16" Height="16"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />

                            <!-- File / folder name -->
                            <TextBlock x:Name="NodeName"
                                       Text="{Binding Name}"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <HierarchicalDataTemplate.Triggers>
                            <!-- Video file -->
                            <DataTrigger Binding="{Binding IsVideoFile}" Value="True">
                                <Setter TargetName="VideoIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="GenericFileIcon" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>

                            <!-- Non-video, non-directory file — show generic icon + tooltip -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDirectory}" Value="False" />
                                    <Condition Binding="{Binding IsVideoFile}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="GenericFileIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="NodeName" Property="ToolTip">
                                    <Setter.Value>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text=" — Not a supported video format"
                                                 Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        </TextBlock>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>

                            <!-- Hidden node — dim the entire row -->
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="NodeRow" Property="Opacity" Value="0.4" />
                                <Setter TargetName="NodeName" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Grid>
</UserControl>
