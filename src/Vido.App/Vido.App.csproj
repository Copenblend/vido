<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Vido.App</RootNamespace>
    <AssemblyName>Vido</AssemblyName>
    <Version>$(VidoVersion)</Version>
    <ApplicationIcon>Vido.ico</ApplicationIcon>

    <!-- Performance: pre-compile assemblies for faster startup (publish builds) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- TieredCompilation is on by default in .NET 8 but explicit for clarity -->
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDIVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsHostingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vido.Core\Vido.Core.csproj" />
    <ProjectReference Include="..\Vido.Services\Vido.Services.csproj" />
    <ProjectReference Include="..\Vido.ViewModels\Vido.ViewModels.csproj" />
    <ProjectReference Include="..\Vido.Views\Vido.Views.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\RELEASENOTES.md" Link="RELEASENOTES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
